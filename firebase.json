{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/proxy/**",
        "function": {
          "functionId": "api",
          "region": "southamerica-east1"
        }
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}